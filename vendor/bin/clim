#!/system/bin/sh

ROOT="/data/local/androcli"
DB="$ROOT/var/lib/clim"

mkdir -p "$DB"

usage()
{
    echo "clim install <package>"
    echo "clim remove <name>"
    echo "clim list"
    echo "clim info <name>"
}


install()
{
    PKG="$1"

    mkdir -p /tmp/clim

    tar -xf "$PKG" -C /tmp/clim

    NAME=$(grep name /tmp/clim/package.prop | cut -d= -f2)

    echo "Installing $NAME"

    sh /tmp/clim/install.sh

    mkdir -p "$DB/$NAME"

    cp /tmp/clim/package.prop "$DB/$NAME/"
}


remove()
{
    NAME="$1"

    if [ ! -d "$DB/$NAME" ]; then
        echo "Package not installed"
        exit 1
    fi

    if [ -f "$DB/$NAME/remove.sh" ]; then
        sh "$DB/$NAME/remove.sh"
    fi

    rm -rf "$DB/$NAME"
}


list()
{
    ls "$DB"
}


info()
{
    cat "$DB/$1/package.prop"
}


case "$1" in

install)
    install "$2"
;;

remove)
    remove "$2"
;;

list)
    list
;;

info)
    info "$2"
;;

*)
    usage
;;

esac
